# Hugging Face API Token (required for gated AI4Bharat models)
# Get yours at: https://huggingface.co/settings/tokens
HF_TOKEN=your_hugging_face_token_here

# TTS Voice for Marathi speech
# Options: Sunita, Sanjay, Nikhil, Radha, Varun, Isha
TTS_VOICE=Sunita

# Inference mode: "local" (loads models locally) or "api" (uses HF Inference API)
INFERENCE_MODE=api

# Device for local inference: "cpu" or "cuda"
DEVICE=cpu

# CORS origin for frontend (adjust if serving frontend differently)
FRONTEND_ORIGIN=*

# ── LLM (NVIDIA build.nvidia.com free endpoint) ──────────────────────────────
# Get a key at https://build.nvidia.com
NVIDIA_API_KEY=nvapi-your-key-here
# Primary model. Optional fallback queried in parallel if the primary is
# queued/unavailable (left blank by default -- nemotron-3-super-120b-a12b
# returned 404 on every call, so chat no longer hedges to it out of the box).
LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b
LLM_FALLBACK_MODEL=
# If the primary has not answered after LLM_HEDGE_AFTER seconds, the fallback
# is queried in parallel and the first answer wins. LLM_TIMEOUT caps each call.
LLM_HEDGE_AFTER=8
LLM_TIMEOUT=40
LLM_MAX_TOKENS=600
# mr/hi chat pipeline B2: Nemotron answers in English, sarvam-105b (below)
# rewrites to mr/hi. "b2" (default) tries this; "nemotron" switches it off
# entirely and chat behaves exactly as before this phase (plain
# Nemotron-direct for mr/hi too). CHAT_NEMOTRON_TIMEOUT_S caps the English
# answer step, CHAT_REWRITE_TIMEOUT_S caps the rewrite step (or whatever's
# left of CHAT_TOTAL_TIMEOUT_S, if less) -- the whole b2+fallback chain
# never runs past CHAT_TOTAL_TIMEOUT_S.
CHAT_LLM_PROVIDER=b2
CHAT_NEMOTRON_TIMEOUT_S=8
CHAT_REWRITE_TIMEOUT_S=4
CHAT_TOTAL_TIMEOUT_S=14

# ── Crop recommendation (forwards to crop_api, port 5003) ───────────────────
# crop_api's URL and /api/crop's own model/hedge/total-time settings for the
# LLM call that explains crop_api's rule-based recommendations. Independent
# of LLM_MODEL/LLM_FALLBACK_MODEL/LLM_HEDGE_AFTER above, which are /api/chat's.
CROP_API_URL=http://127.0.0.1:5003
# Super answered faster than Ultra in practice, so Super goes first and Ultra
# is only the hedge backup.
CROP_LLM_MODEL=nvidia/nemotron-3-super-120b-a12b
CROP_LLM_FALLBACK_MODEL=nvidia/nemotron-3-ultra-550b-a55b
CROP_LLM_HEDGE_AFTER=5
CROP_LLM_TOTAL_TIMEOUT=10
# optional: a separate NVIDIA key for /api/crop, so its traffic is rate-limited
# independently of /api/chat. Leave unset to reuse NVIDIA_API_KEY above.
NVIDIA_API_KEY_CROP=

# ── Sarvam AI (mr/hi crop explanations only; Nemotron above stays the ───────
# fallback, and the only path for English) ──────────────────────────────────
# Get a key at https://www.sarvam.ai (dashboard -> API keys). Never commit
# the real key -- this file only ever holds a placeholder.
SARVAM_API_KEY=sarvam-your-key-here
# Per-call timeout (seconds) and a free-tier daily request cap, reset at
# IST midnight (see backend/data/sarvam_usage.json, git-ignored).
SARVAM_TIMEOUT_S=6
SARVAM_MAX_REQUESTS_PER_DAY=300
# "sarvam" (default) tries Sarvam first for mr/hi crop text, falling back to
# Nemotron; "nemotron" switches Sarvam off entirely.
CROP_LLM_PROVIDER=sarvam
# For mr/hi, the whole Sarvam->Nemotron chain is capped at this many seconds
# total; Nemotron gets whatever's left after Sarvam, down to this floor.
CROP_PROVIDER_TOTAL_TIMEOUT_S=12
CROP_LLM_MIN_FALLBACK_TIMEOUT_S=3

# ── Disease explanation (mr/hi only; same Sarvam->Nemotron->rules chain, ───
# 12s budget, and daily cap as crop above) ──────────────────────────────────
# "sarvam" (default) tries Sarvam first for mr/hi; "nemotron" switches it off.
DISEASE_LLM_PROVIDER=sarvam
# Below this top-guess probability (but still status=="ok"), the prompt is
# told confidence is low and must tell the farmer to confirm with the KVK.
DISEASE_LOW_CONFIDENCE_THRESHOLD=0.85
